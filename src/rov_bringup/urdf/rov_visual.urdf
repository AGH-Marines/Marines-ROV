<?xml version="1.0"?>
<robot name="rov_visual">
  <!--
    Purely a visual skeleton of the ROV for RViz (no physics/collision at all).
    Everything hangs off "base_link" so as not to create extra TF frames that
    would collide with the ones already published by Stonefish/static_transform_publisher.
  -->
  <link name="base_link">
    <!-- Approximate hull (bounding box based on the thruster layout in underwater_world.scn) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.53 0.42 0.25"/>
      </geometry>
      <material name="hull_gray">
        <color rgba="0.6 0.6 0.6 0.35"/>
      </material>
    </visual>

    <!-- Camera / multibeam (shared mounting point, xyz="0.35 0 0" as in underwater_world.scn) -->
    <visual>
      <origin xyz="0.35 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.04"/>
      </geometry>
      <material name="camera_yellow">
        <color rgba="1.0 0.8 0.0 1.0"/>
      </material>
    </visual>

    <!-- Arrow showing the camera's viewing direction (+X from the camera) -->
    <visual>
      <origin xyz="0.5 0 0" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.3"/>
      </geometry>
      <material name="boresight_red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>
</robot>
