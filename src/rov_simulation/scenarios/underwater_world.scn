<?xml version="1.0"?>
<scenario>
    <environment>
        <ned latitude="41.7" longitude="3.0"/>
        <ocean>
            <water_density value="1000.0"/>
            <current velocity="0.0 0.0 0.0"/>
        </ocean>
        <atmosphere>
            <sun direction="0.5 0.5 1.0"/>
        </atmosphere>
    </environment>

    <materials>
        <material name="Neutral" density="1000.0" restitution="0.5"/>
        <material name="Rock" density="3000.0" restitution="0.8"/>
        <material name="Aluminium" density="2700.0" restitution="0.7"/>
        <material name="Steel" density="7800.0" restitution="0.2"/>
    </materials>

    <looks>
        <look name="nr2" gray="1.0" roughness="0.4" metalness="0.5" texture="new_robot/new_robot_texture.png"/>
        <look name="blue" rgb="0.0 0.5 1.0" roughness="0.3"/>
        <look name="black" rgb="0.0 0.0 0.0" roughness="0.3"/>

        <look name="pool_tiles" rgb="0.8 0.9 0.9" roughness="0.7"/>
        <look name="wall_color" rgb="0.6 0.7 0.7" roughness="0.5"/>
        <look name="box_red" rgb="1.0 0.2 0.2" roughness="0.5"/>
        <look name="box_green" rgb="0.2 1.0 0.2" roughness="0.5"/>
        <look name="box_yellow" rgb="1.0 0.9 0.1" roughness="0.5"/>
    </looks>

    <static name="PoolBottom" type="plane">
        <material name="Rock"/>
        <look name="pool_tiles"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 4.0"/>
    </static>

    <static name="WallNorth" type="box">
        <dimensions xyz="0.2 10.0 4.0"/>
        <material name="Rock"/>
        <look name="wall_color"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="5.0 0.0 2.0"/>
    </static>

    <static name="WallSouth" type="box">
        <dimensions xyz="0.2 10.0 4.0"/>
        <material name="Rock"/>
        <look name="wall_color"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-5.0 0.0 2.0"/>
    </static>

    <static name="WallEast" type="box">
        <dimensions xyz="10.0 0.2 4.0"/>
        <material name="Rock"/>
        <look name="wall_color"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="0.0 5.0 2.0"/>
    </static>

    <static name="WallWest" type="box">
        <dimensions xyz="10.0 0.2 4.0"/>
        <material name="Rock"/>
        <look name="wall_color"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="0.0 -5.0 2.0"/>
    </static>

    <static name="Obstacle1" type="box">
        <dimensions xyz="1.0 1.0 1.0"/>
        <material name="Rock"/>
        <look name="box_red"/>
        <world_transform rpy="0.0 0.0 0.78" xyz="2.0 2.0 3.5"/>
    </static>

    <static name="Obstacle2" type="box">
        <dimensions xyz="0.5 0.5 2.5"/>
        <material name="Rock"/>
        <look name="box_green"/>
        <world_transform rpy="0.0 0.0 0.0" xyz="-2.5 1.5 2.75"/>
    </static>

    <static name="Obstacle3" type="box">
        <dimensions xyz="3.0 0.5 0.5"/>
        <material name="Rock"/>
        <look name="box_yellow"/>
        <world_transform rpy="0.0 0.0 0.5" xyz="0.0 -2.5 3.75"/>
    </static>

    <robot name="ROV" fixed="false" self_collisions="false">
       <base_link name="base_link" type="compound" physics="submerged">
          <external_part name="HullBottom" type="model" physics="submerged" buoyant="true">
             <physical>
                <mesh filename="new_robot/new_robot.obj" scale="0.1"/>
                <origin rpy="3.14 0.0 -1.570796" xyz="0.0 0.0 0.0"/>
                <thickness value="0.0025"/>
             </physical>
             <mass value="10.0" />
             <material name="Aluminium"/>
             <look name="nr2"/>
             <compound_transform rpy="0 0.0 0.0" xyz="-0.0 0.0 0.0"/>
          </external_part>

          <internal_part name="Tube" type="cylinder" physics="submerged" buoyant="true">
             <dimensions radius="0.1" height="0.3"/>
             <origin xyz="0.0 0.0 -0.1" rpy="0.0 -1.570796 0.0"/>
             <material name="Neutral"/>
             <look name="None"/>
             <mass value="4.5"/>
             <mass value="4.5"/>
             <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.1"/>
          </internal_part>
       </base_link>

       <actuator name="FrontRight" type="thruster">
          <link name="base_link"/>
          <origin xyz="-0.149471 -0.189471 -0.013" rpy="0 0 -0.7853981634"/>
          <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3931.0" inverted="false" max_setpoint="411.653357" normalized_setpoint="true"/>
          <rotor_dynamics type="zero_order"/>
          <thrust_model type="fluid_dynamics">
             <thrust_coeff  forward="0.167" reverse="0.167"/>
             <torque_coeff value="0.016"/>
          </thrust_model>
          <propeller diameter="0.076" right="true">
             <mesh filename="bluerov2/ccw.obj" scale="1.0"/>
             <material name="Neutral"/>
             <look name="blue"/>
          </propeller>
       </actuator>

       <actuator name="FrontLeft" type="thruster">
          <link name="base_link"/>
          <origin xyz="-0.149471 0.189471 -0.013" rpy="0 0 0.7853981634"/>
          <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3931.0" inverted="false" max_setpoint="411.653357" normalized_setpoint="true"/>
          <rotor_dynamics type="zero_order"/>
          <thrust_model type="fluid_dynamics">
             <thrust_coeff  forward="0.167" reverse="0.167"/>
             <torque_coeff value="0.016"/>
          </thrust_model>
          <propeller diameter="0.076" right="true">
             <mesh filename="bluerov2/ccw.obj" scale="1.0"/>
             <material name="Neutral"/>
             <look name="blue"/>
          </propeller>
       </actuator>

       <actuator name="BackRight" type="thruster">
          <link name="base_link"/>
          <origin xyz="0.149471 -0.189471 -0.013" rpy="0 0 -2.3561944902"/>
          <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3931.0" inverted="true" max_setpoint="411.653357" normalized_setpoint="true"/>
          <rotor_dynamics type="zero_order"/>
          <thrust_model type="fluid_dynamics">
             <thrust_coeff  forward="0.167" reverse="0.167"/>
             <torque_coeff value="0.016"/>
          </thrust_model>
          <propeller diameter="0.076" right="true">
             <mesh filename="bluerov2/cw.obj" scale="1.0"/>
             <material name="Neutral"/>
             <look name="blue"/>
          </propeller>
       </actuator>

       <actuator name="BackLeft" type="thruster">
          <link name="base_link"/>
          <origin xyz="0.149471 0.189471 -0.013" rpy="0 0 2.3561944902"/>
          <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3931.0" inverted="true" max_setpoint="411.653357" normalized_setpoint="true"/>
          <rotor_dynamics type="zero_order"/>
          <thrust_model type="fluid_dynamics">
             <thrust_coeff  forward="0.167" reverse="0.167"/>
             <torque_coeff value="0.016"/>
          </thrust_model>
          <propeller diameter="0.076" right="true">
             <mesh filename="bluerov2/cw.obj" scale="1.0"/>
             <material name="Neutral"/>
             <look name="blue"/>
          </propeller>
       </actuator>

       <actuator name="DiveFrontRight" type="thruster">
          <link name="base_link"/>
          <origin xyz="0.26325 0.20925 -0.0075" rpy="0 -1.5707963268 0"/>
          <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3931.0" inverted="false" max_setpoint="411.653357" normalized_setpoint="true"/>
          <rotor_dynamics type="zero_order"/>
          <thrust_model type="fluid_dynamics">
             <thrust_coeff  forward="0.167" reverse="0.167"/>
             <torque_coeff value="0.016"/>
          </thrust_model>
          <propeller diameter="0.076" right="false">
             <mesh filename="bluerov2/cw.obj" scale="1.0"/>
             <material name="Neutral"/>
             <look name="blue"/>
          </propeller>
       </actuator>

       <actuator name="DiveFrontLeft" type="thruster">
          <link name="base_link"/>
          <origin xyz="0.26325 -0.20925 -0.0075" rpy="0 -1.5707963268 0"/>
          <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3931.0" inverted="true" max_setpoint="411.653357" normalized_setpoint="true"/>
          <rotor_dynamics type="zero_order"/>
          <thrust_model type="fluid_dynamics">
             <thrust_coeff  forward="0.167" reverse="0.167"/>
             <torque_coeff value="0.016"/>
          </thrust_model>
          <propeller diameter="0.076" right="false">
             <mesh filename="bluerov2/ccw.obj" scale="1.0"/>
             <material name="Neutral"/>
             <look name="blue"/>
          </propeller>
       </actuator>

       <actuator name="DiveBackRight" type="thruster">
          <link name="base_link"/>
          <origin xyz="-0.26325 0.20925 -0.0075" rpy="0 -1.5707963268 0"/>
          <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3931.0" inverted="true" normalized_setpoint="true" max_setpoint="411.653357"/>
          <rotor_dynamics type="zero_order"/>
          <thrust_model type="fluid_dynamics">
             <thrust_coeff  forward="0.167" reverse="0.167"/>
             <torque_coeff value="0.016"/>
          </thrust_model>
          <propeller diameter="0.076" right="false">
             <mesh filename="bluerov2/ccw.obj" scale="1.0"/>
             <material name="Neutral"/>
             <look name="blue"/>
          </propeller>
       </actuator>

       <actuator name="DiveBackLeft" type="thruster">
          <link name="base_link"/>
          <origin xyz="-0.26325 -0.20925 -0.0075" rpy="0 -1.5707963268 0"/>
          <specs thrust_coeff="0.167" torque_coeff="0.016" max_rpm="3931.0" inverted="false" max_setpoint="411.653357" normalized_setpoint="true"/>
          <rotor_dynamics type="zero_order"/>
          <thrust_model type="fluid_dynamics">
             <thrust_coeff  forward="0.167" reverse="0.167"/>
             <torque_coeff value="0.016"/>
          </thrust_model>
          <propeller diameter="0.076" right="false">
             <mesh filename="bluerov2/cw.obj" scale="1.0"/>
             <material name="Neutral"/>
             <look name="blue"/>
          </propeller>
       </actuator>

       <sensor name="odometry" type="odometry" rate="100.0">
          <noise position="0.05" velocity="0.01" angle="0.1" angular_velocity="0.05"/>
          <link name="base_link"/>
          <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
          <ros_publisher topic="/marines_rov/odometry"/>
       </sensor>

       <sensor name="imu_filter" type="imu" rate="20.0">
          <link name="base_link"/>
          <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
          <noise angle="0.000001745" angular_velocity="0.00001745"/>
          <ros_publisher topic="/marines_rov/imu"/>
       </sensor>

        <sensor name="zed_camera" type="camera" rate="15.0">
          <link name="base_link"/>
          <origin rpy="0.0 0.0 0.0" xyz="0.2 0.0 0.0"/>
          <specs resolution_x="640" resolution_y="480" horizontal_fov="75.0"/>
          <ros_publisher topic="/marines_rov/zed"/>
       </sensor>
        <sensor name="zed_left" type="camera" rate="15.0">
          <link name="base_link"/>
          <origin rpy="0.0 0.0 0.0" xyz="0.2 0.06 0.0"/>
          <specs resolution_x="640" resolution_y="480" horizontal_fov="75.0"/>
          <ros_publisher topic="/marines_rov/zed/left"/>
       </sensor>
        <sensor name="multibeam_3d" rate="15.0" type="multibeam2d">
          <link name="base_link"/>
          <origin rpy="0.0 0.0 0.0" xyz="0.2 0.0 0.0"/>
          <specs resolution_x="256" resolution_y="64" horizontal_fov="120.0" vertical_fov="20.0" range_min="0.5" range_max="15.0"/>
          <ros_publisher topic="/marines_rov/point_cloud"/>
       </sensor>
       <sensor name="zed_right" type="camera" rate="15.0">
          <link name="base_link"/>
          <origin rpy="0.0 0.0 0.0" xyz="0.2 -0.06 0.0"/>
          <specs resolution_x="640" resolution_y="480" horizontal_fov="75.0"/>
          <ros_publisher topic="/marines_rov/zed/right"/>
       </sensor>
        <sensor name="dvl" type="dvl" rate="10.0">
          <link name="base_link"/>
          <origin rpy="3.1416 0.0 0.0" xyz="0.0 0.0 0.1"/>
          <specs beam_angle="30.0"/>
          <range velocity="9.0 9.0 9.0" altitude_min="0.2" altitude_max="100.0"/>
          <noise velocity="0.005" altitude="0.01"/>
          <ros_publisher topic="/marines_rov/dvl_raw" altitude_topic="/marines_rov/altitude"/>
        </sensor>
       <world_transform xyz="0.0 0.0 1.0" rpy="0.0 0.0 0.0"/>

       <ros_subscriber thrusters="/thrusters/STONEFISH"/>
       <ros_publisher thrusters="/marines_rov/thruster_state"/>
    </robot>
</scenario>